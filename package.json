{
  "name": "off-peak",
  "version": "0.1.0",
  "private": true,
  "description": "Off-Peak: an Alexa+ add-on (MCP server) that cuts the power bill without wrecking the evening.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "workspaces": [
    "packages/tou-rates",
    "packages/core",
    "packages/server",
    "packages/ui-apps",
    "packages/web"
  ],
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "npm run build --workspaces --if-present",
    "lint": "npm run typecheck --workspaces --if-present && npm run typecheck:worker",
    "inspector": "npx -y @modelcontextprotocol/inspector@0.22.0",
    "bedrock:models": "node scripts/bedrock-models.mjs",
    "build:lambda": "npm run build:lambda -w @off-peak/server",
    "cdk:synth": "cd infra && npm install && npx cdk synth",
    "build:worker": "npm run build -w tou-rates && npm run build -w @off-peak/ui-apps && npm run build -w @off-peak/web -- --mode worker && node scripts/build-worker.mjs",
    "deploy": "npm run build:worker && wrangler deploy",
    "dev:worker": "npm run build:worker && wrangler dev --port 8790",
    "typecheck:worker": "tsc -p worker/tsconfig.json",
    "test:e2e": "playwright test",
    "verify:submission": "node scripts/verify-submission.mjs",
    "record:demo": "node scripts/record-demo.mjs"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261019.1",
    "@playwright/test": "^1.64.1",
    "@types/node": "^22.19.0",
    "esbuild": "^0.28.2",
    "typescript": "6.0.3",
    "vitest": "5.0.5",
    "wrangler": "^4.151.2"
  }
}
