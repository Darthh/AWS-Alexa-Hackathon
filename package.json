{
  "name": "off-peak",
  "version": "0.1.0",
  "private": true,
  "description": "Off-Peak: an Alexa+ add-on (MCP server) that cuts the power bill without wrecking the evening.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "workspaces": [
    "packages/tou-rates",
    "packages/core",
    "packages/server",
    "packages/ui-apps",
    "packages/web"
  ],
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "npm run build --workspaces --if-present",
    "lint": "npm run typecheck --workspaces --if-present",
    "inspector": "npx -y @modelcontextprotocol/inspector@0.22.0"
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "typescript": "6.0.3",
    "vitest": "5.0.5"
  }
}
