{
  "name": "@off-peak/server",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "dev": "node --watch src/main.ts",
    "start": "node src/main.ts",
    "typecheck": "tsc -p tsconfig.json",
    "build:lambda": "npm run build -w @off-peak/ui-apps --prefix ../.. && vite build -c vite.lambda.config.ts && node scripts/package-lambda.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-bedrock-runtime": "^3.1153.0",
    "@aws-sdk/client-dynamodb": "^3.1153.0",
    "@aws-sdk/client-polly": "^3.1153.0",
    "@aws-sdk/client-scheduler": "^3.1152.0",
    "@aws-sdk/lib-dynamodb": "^3.1153.0",
    "@modelcontextprotocol/ext-apps": "^1.7.5",
    "@modelcontextprotocol/sdk": "1.32.1",
    "@off-peak/core": "0.1.0",
    "express": "^5.2.1",
    "luxon": "^3.7.2",
    "tou-rates": "0.1.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/luxon": "^3.7.6",
    "vite": "8.3.4"
  }
}
